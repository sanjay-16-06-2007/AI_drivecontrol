                            <div class="flex justify-between">
                                <span class="text-slate-400">Nearest Slot:</span>
                                <span class="font-mono text-emerald-400">Slot 01 (120m)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Widget 2: V2X Speed Advisory HUD -->
                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-4">
                        <div class="flex justify-between items-center">
                            <h3 class="font-bold text-white text-sm">HUD Speed Advisory</h3>
                            <span class="text-xs font-mono text-cyan-400">V2I Sync</span>
                        </div>

                        <div class="text-center py-2">
                            <p class="text-xs text-slate-400">Target Eco-Velocity ($V_{\text{opt}}$)</p>
                            <p id="targetSpeed" class="text-4xl font-display font-extrabold text-cyan-400 mt-1">42 <span class="text-sm font-normal text-slate-400">km/h</span></p>
                            <p id="greenWaveStatus" class="text-xs text-emerald-400 font-mono mt-1">&#10003; Catching Green Signal Wave in 350m</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs text-slate-400 flex justify-between">
                                <span>Dist to Next Signal/Turn:</span>
                                <span id="distVal" class="font-mono text-white">350 m</span>
                            </label>
                            <input type="range" id="distSlider" min="50" max="1000" value="350" class="w-full accent-cyan-400 bg-slate-800" oninput="updateSpeedAdvisory(this.value)">
                        </div>
                    </div>

                    <!-- Widget 3: Live Eco Score & Lane Visualizer -->
                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-4">
                        <div class="flex justify-between items-center">
                            <h3 class="font-bold text-white text-sm">Active Lane Guidance</h3>
                            <span class="text-xs font-mono text-emerald-400">Air-Fuel 14.7:1</span>
                        </div>

                        <div id="laneGuideBox" class="p-3 bg-cyan-950/40 border border-cyan-800 rounded-lg text-center">
                            <p class="text-xs text-slate-400">Recommended Corridor</p>
                            <p id="recommendedLane" class="text-xl font-bold text-cyan-300 mt-1">LANE 2 (Center Cruising)</p>
                            <p class="text-[10px] text-slate-400 mt-1">Optimal flow rate. Minimal lane shifting required.</p>
                        </div>

                        <div class="flex justify-between items-center pt-2">
                            <span class="text-xs text-slate-400">Trip Carbon Saved:</span>
                            <span class="text-sm font-mono font-bold text-emerald-400">1.42 kg CO2</span>
                        </div>
                    </div>

                </div>
            </section>


            <!-- SLIDE 7: WORKING MODEL ANIMATION (CANVAS SIMULATION) -->
            <section id="slide-7" class="slide-content hidden space-y-6">
                <div class="border-b border-slate-800 pb-3 flex justify-between items-center">
                    <div>
                        <span class="text-xs font-mono text-cyan-400 uppercase">Slide 07 / Dynamic Working Model</span>
                        <h2 class="text-3xl font-display font-bold text-white mt-1">Interactive Traffic & Parking Simulation</h2>
                    </div>
                    <div class="space-x-2">
                        <button onclick="toggleSim()" id="simBtn" class="px-3 py-1 bg-brand-accent text-brand-dark text-xs font-bold rounded">Pause Sim</button>
                        <button onclick="resetSim()" class="px-3 py-1 bg-slate-800 text-slate-300 text-xs rounded">Reset</button>
                    </div>
                </div>

                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                    <p class="text-xs font-mono text-slate-400 mb-2">3-Lane Highway & Smart Park Ingress Flow (Live Canvas Canvas Rendering)</p>
                    
                    <!-- Canvas Container -->
                    <div class="relative w-full h-64 bg-slate-900 rounded-lg overflow-hidden border border-slate-800">
                        <canvas id="simCanvas" class="w-full h-full block"></canvas>
                    </div>

                    <div class="grid grid-cols-3 gap-2 mt-4 text-center text-xs">
                        <div class="p-2 bg-slate-900 rounded border border-slate-800">
                            <span class="text-red-400 font-bold">Lane 1:</span> Ingress/Turning Queue
                        </div>
                        <div class="p-2 bg-slate-900 rounded border border-cyan-800">
                            <span class="text-cyan-400 font-bold">Lane 2:</span> Steady Eco Stream
                        </div>
                        <div class="p-2 bg-slate-900 rounded border border-slate-800">
                            <span class="text-purple-400 font-bold">Lane 3:</span> Fast Overtaking
                        </div>
                    </div>
                </div>
            </section>


            <!-- SLIDE 8: MACRO IMPACT & CITY-WIDE RESULT -->
            <section id="slide-8" class="slide-content hidden space-y-6">
                <div class="border-b border-slate-800 pb-3">
                    <span class="text-xs font-mono text-cyan-400 uppercase">Slide 08 / Projected Impact</span>
                    <h2 class="text-3xl font-display font-bold text-white mt-1">What Changes When Fully Deployed?</h2>
                </div>

                <div class="grid md:grid-cols-2 gap-6 items-center">
                    
                    <div class="space-y-4">
                        <div class="bg-brand-card p-4 rounded-xl border border-slate-800">
                            <h4 class="font-bold text-emerald-400 text-base">35% Tailpipe Emissions Cut</h4>
                            <p class="text-xs text-slate-400 mt-1">Eliminating parking search idling and smoothing 3-lane acceleration shockwaves directly curtails CO2 and NOx output across urban grids.</p>
                        </div>

                        <div class="bg-brand-card p-4 rounded-xl border border-slate-800">
                            <h4 class="font-bold text-cyan-400 text-base">25% Reduction in Travel Time</h4>
                            <p class="text-xs text-slate-400 mt-1">V2I dynamic green wave signal sync ensures vehicle platoons pass continuously without reaching zero velocity.</p>
                        </div>

                        <div class="bg-brand-card p-4 rounded-xl border border-slate-800">
                            <h4 class="font-bold text-purple-400 text-base">45% Reduced Traffic Bottlenecks</h4>
                            <p class="text-xs text-slate-400 mt-1">Predictive lookahead guidance prevents premature lane-changing near highway exits and parking ingress zones.</p>
                        </div>
                    </div>

                    <!-- Chart Container for Chart.js -->
                    <div class="bg-brand-card p-4 rounded-xl border border-slate-800">
                        <p class="text-xs font-mono text-slate-400 mb-2 text-center uppercase">Pre vs Post Deployment Performance Metrics</p>
                        <div class="chart-container">
                            <canvas id="impactChart"></canvas>
                        </div>
                    </div>

                </div>
            </section>


            <!-- SLIDE 9: INNOVATION HIGHLIGHTS & HACKATHON PITCH CLOSING -->
            <section id="slide-9" class="slide-content hidden space-y-6">
                <div class="border-b border-slate-800 pb-3">
                    <span class="text-xs font-mono text-cyan-400 uppercase">Slide 09 / Novel Proposals</span>
                    <h2 class="text-3xl font-display font-bold text-white mt-1">4 Novel Suggestions & Future Vision</h2>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-mono px-2 py-0.5 bg-cyan-950 text-cyan-400 rounded">01</span>
                            <h3 class="font-bold text-white">AI Predictive Terrain Cruise Control (PTCC)</h3>
                        </div>
                        <p class="text-xs text-slate-400">Uses 3D topographic GIS maps to build momentum before steep inclines and coast downhill, delivering an additional 8-12% fuel savings over standard cruise control.</p>
                    </div>

                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-mono px-2 py-0.5 bg-emerald-950 text-emerald-400 rounded">02</span>
                            <h3 class="font-bold text-white">Multi-Lane V2X Speed Advisory HUD</h3>
                        </div>
                        <p class="text-xs text-slate-400">AR windshield HUD connected to smart city signal light arrays, recommending exact target lane and eco-speeds to catch continuous green waves.</p>
                    </div>

                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-mono px-2 py-0.5 bg-purple-950 text-purple-400 rounded">03</span>
                            <h3 class="font-bold text-white">Eco-Corridor Green Wave Dynamic Sync</h3>
                        </div>
                        <p class="text-xs text-slate-400">Municipal traffic signals dynamically adjust green timing phases to incoming clusters of eco-guided vehicles, keeping traffic moving as platoons.</p>
                    </div>

                    <div class="bg-brand-card p-5 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-mono px-2 py-0.5 bg-amber-950 text-amber-400 rounded">04</span>
                            <h3 class="font-bold text-white">Driver Carbon Credit Rewards System</h3>
                        </div>
                        <p class="text-xs text-slate-400">Telematics score smooth driving and slope energy management, earning micro-credits redeemable for discounted smart parking or public transit.</p>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-cyan-950 to-emerald-950 border border-cyan-700/60 rounded-xl p-6 text-center space-y-3 mt-6">
                    <h3 class="text-2xl font-display font-bold text-white">Ready for Smart City Deployment</h3>
                    <p class="text-xs text-slate-300 max-w-xl mx-auto">
                        Combining VEGA ARIES IoT V2 hardware, real-time sensor processing, dynamic 3-lane trajectory optimization, and terrain-aware speed controls into one scalable ecosystem.
                    </p>
                    <div class="pt-2">
                        <button onclick="goToSlide(1)" class="px-6 py-2.5 bg-brand-accent text-brand-dark rounded-lg font-bold text-xs uppercase tracking-wider hover:bg-cyan-300 transition">
                            Replay Presentation
                        </button>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // --- State Management ---
        let currentSlide = 1;
        const totalSlides = 9;

        const slidesMeta = [
            { id: 1, title: "01. Title & Cover" },
            { id: 2, title: "02. Urban Crisis & Problem" },
            { id: 3, title: "03. Integrated Solution" },
            { id: 4, title: "04. Hardware & Circuit" },
            { id: 5, title: "05. 3-Lane & Terrain Math" },
            { id: 6, title: "06. Interactive Dashboard" },
            { id: 7, title: "07. Working Model Sim" },
            { id: 8, title: "08. Macro City Impact" },
            { id: 9, title: "09. 4 Novel Innovations" }
        ];

        // --- Navigation Setup ---
        function initNav() {
            const menuContainer = document.getElementById('slideMenu');
            menuContainer.innerHTML = '';
            
            slidesMeta.forEach(slide => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left px-3 py-2 rounded-lg text-xs transition flex justify-between items-center ${
                    slide.id === currentSlide ? 'bg-cyan-950 text-cyan-300 font-bold border border-cyan-800/80' : 'text-slate-400 hover:bg-slate-900 hover:text-slate-200'
                }`;
                btn.onclick = () => goToSlide(slide.id);
                btn.innerHTML = `<span>${slide.title}</span>`;
                menuContainer.appendChild(btn);
            });

            document.getElementById('slideIndicator').innerText = `Slide ${currentSlide} / ${totalSlides}`;
            document.getElementById('prevBtn').disabled = currentSlide === 1;
            document.getElementById('nextBtn').disabled = currentSlide === totalSlides;
        }

        function changeSlide(direction) {
            let target = currentSlide + direction;
            if (target >= 1 && target <= totalSlides) {
                goToSlide(target);
            }
        }

        function goToSlide(slideNum) {
            document.getElementById(`slide-${currentSlide}`).classList.add('hidden');
            currentSlide = slideNum;
            document.getElementById(`slide-${currentSlide}`).classList.remove('hidden');
            initNav();

            // Trigger canvas or chart re-render if visible
            if (currentSlide === 7) {
                initSimCanvas();
            } else if (currentSlide === 8) {
                initImpactChart();
            }
        }

        // --- Slide 6 Interactive Dashboard Functions ---
        let slotStates = { 1: false, 2: true }; // false = vacant, true = occupied

        function toggleSlot(slotNum) {
            slotStates[slotNum] = !slotStates[slotNum];
            const slotEl = document.getElementById(`slot${slotNum}`);
            const textEl = document.getElementById(`slot${slotNum}-text`);

            if (slotStates[slotNum]) {
                textEl.innerText = "OCCUPIED";
                textEl.className = "text-lg font-bold text-red-400";
                slotEl.className = "p-3 bg-slate-900 border border-red-900/50 rounded-lg text-center cursor-pointer";
            } else {
                textEl.innerText = "VACANT";
                textEl.className = "text-lg font-bold text-emerald-400";
                slotEl.className = "p-3 bg-slate-900 border border-slate-700 rounded-lg text-center cursor-pointer";
            }

            // Update Vacant Count
            let vacant = 0;
            if(!slotStates[1]) vacant++;
            if(!slotStates[2]) vacant++;
            document.getElementById('vacantCount').innerText = `${vacant} / 2`;
        }

        function updateSpeedAdvisory(dist) {
            document.getElementById('distVal').innerText = `${dist} m`;
            
            // Formula V_opt = sqrt(2 * a_eco * d) -> assuming a_eco = 1.1 m/s^2
            let distMeters = parseFloat(dist);
            let vMps = Math.min(16.6, Math.sqrt(2 * 1.1 * distMeters)); // Cap at 60 km/h (16.6 m/s)
            let vKmh = Math.round(vMps * 3.6);

            document.getElementById('targetSpeed').innerHTML = `${vKmh} <span class="text-sm font-normal text-slate-400">km/h</span>`;

            const statusEl = document.getElementById('greenWaveStatus');
            const laneGuideBox = document.getElementById('laneGuideBox');
            const recommendedLane = document.getElementById('recommendedLane');

            if (distMeters < 150) {
                statusEl.innerHTML = `&#9888; Approaching Turning Radius / Slot Ingress - Decelerate`;
                statusEl.className = "text-xs text-amber-400 font-mono mt-1";
                recommendedLane.innerText = "LANE 1 (Slow / Ingress)";
                recommendedLane.className = "text-xl font-bold text-red-400 mt-1";
            } else {
                statusEl.innerHTML = `&#10003; Catching Green Signal Wave in ${distMeters}m`;
                statusEl.className = "text-xs text-emerald-400 font-mono mt-1";
                recommendedLane.innerText = "LANE 2 (Center Cruising)";
                recommendedLane.className = "text-xl font-bold text-cyan-300 mt-1";
            }
        }

        // --- Slide 7 Simulation Canvas Engine ---
        let simRunning = true;
        let simAnimationId = null;
        let cars = [];

        function initSimCanvas() {
            const canvas = document.getElementById('simCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Adjust canvas size to container
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            // Spawn initial vehicles across 3 lanes
            cars = [
                { x: 10, lane: 0, speed: 2.2, color: '#F87171', label: 'Ingress' },
                { x: 150, lane: 1, speed: 3.5, color: '#00F2FE', label: 'Eco' },
                { x: 50, lane: 1, speed: 3.2, color: '#10B981', label: 'Eco' },
                { x: 80, lane: 2, speed: 4.8, color: '#C084FC', label: 'Fast' }
            ];

            if (simAnimationId) cancelAnimationFrame(simAnimationId);
            runSimLoop(canvas, ctx);
        }

        function runSimLoop(canvas, ctx) {
            if (!simRunning) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const laneHeight = canvas.height / 3;

            // Draw Lane Dividers
            ctx.strokeStyle = '#334155';
            ctx.setLineDash([10, 10]);
            ctx.lineWidth = 2;

            // Divider 1
            ctx.beginPath();
            ctx.moveTo(0, laneHeight);
            ctx.lineTo(canvas.width, laneHeight);
            ctx.stroke();

            // Divider 2
            ctx.beginPath();
            ctx.moveTo(0, laneHeight * 2);
            ctx.lineTo(canvas.width, laneHeight * 2);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw Smart Park Slot Indicator on Lane 1 (Bottom)
            ctx.fillStyle = '#064E3B';
            ctx.fillRect(canvas.width - 120, laneHeight * 2 + 5, 100, laneHeight - 10);
            ctx.strokeStyle = '#10B981';
            ctx.lineWidth = 1;
            ctx.strokeRect(canvas.width - 120, laneHeight * 2 + 5, 100, laneHeight - 10);

            ctx.fillStyle = '#34D399';
            ctx.font = '10px monospace';
            ctx.fillText('SMART PARK BAY', canvas.width - 110, laneHeight * 2 + 25);

            // Update & Render Vehicles
            cars.forEach(car => {
                car.x += car.speed;

                // Loop vehicles around canvas
                if (car.x > canvas.width + 40) {
                    car.x = -50;
                }

                // Calculate Y position based on lane
                let yPos = car.lane * laneHeight + (laneHeight / 2) - 10;

                // Predictive lane shift simulation: Eco car shifts to Lane 1 near parking slot
                if (car.label === 'Eco' && car.x > canvas.width - 250 && car.x < canvas.width - 180 && car.lane === 1) {
                    car.lane = 2; // Shift down into ingress lane
                    car.speed = 1.8; // Smooth eco deceleration
                } else if (car.x < 50 && car.label === 'Eco') {
                    car.lane = 1; // Reset back to center cruising lane
                    car.speed = 3.5;
                }

                // Draw Vehicle Box
                ctx.fillStyle = car.color;
                ctx.beginPath();
                ctx.roundRect(car.x, yPos, 36, 18, 4);
                ctx.fill();

                // Label
                ctx.fillStyle = '#0F172A';
                ctx.font = 'bold 8px sans-serif';
                ctx.fillText(car.label, car.x + 4, yPos + 12);
            });

            simAnimationId = requestAnimationFrame(() => runSimLoop(canvas, ctx));
        }

        function toggleSim() {
            simRunning = !simRunning;
            const btn = document.getElementById('simBtn');
            if (simRunning) {
                btn.innerText = "Pause Sim";
                initSimCanvas();
            } else {
                btn.innerText = "Resume Sim";
            }
        }

        function resetSim() {
            initSimCanvas();
        }


        // --- Slide 8 Impact Chart.js Integration ---
        let impactChartInstance = null;

        function initImpactChart() {
            const canvas = document.getElementById('impactChart');
            if (!canvas) return;

            if (impactChartInstance) {
                impactChartInstance.destroy();
            }

            // Labels with 16-char wrapping logic as mandated
            const labels = [
                ['Tailpipe Emissions', '(g CO2/km)'],
                ['Idling Idle Time', '(Minutes/Trip)'],
                ['Traffic Shockwave', 'Frequency'],
                ['Average Speed', 'Consistency (%)']
            ];

            impactChartInstance = new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Standard Unoptimized City',
                            data: [180, 14, 85, 42],
                            backgroundColor: 'rgba(239, 68, 68, 0.6)',
                            borderColor: 'rgba(239, 68, 68, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'With EcoDrive + SmartPark AI',
                            data: [115, 3, 22, 88],
                            backgroundColor: 'rgba(16, 185, 129, 0.7)',
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: '#94A3B8',
                                font: { family: 'Inter', size: 11 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                title: function(context) {
                                    return context[0].label.replaceAll(',', ' ');
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#94A3B8', font: { size: 10 } },
                            grid: { color: '#1E293B' }
                        },
                        y: {
                            ticks: { color: '#94A3B8', font: { size: 10 } },
                            grid: { color: '#1E293B' }
                        }
                    }
                }
            });
        }

        // --- Keyboard Navigation Shortcuts ---
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'Space') {
                changeSlide(1);
            } else if (e.key === 'ArrowLeft') {
                changeSlide(-1);
            }
        });

        // Initialize App
        window.addEventListener('load', () => {
            initNav();
        });
    </script>
