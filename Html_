                    <h2 class="text-3xl font-display font-bold text-white mt-1">3-Lane & Terrain Eco-Optimization Engine</h2>
                </div>

                <!-- 3 Lane Rules Table -->
                <div class="bg-brand-card rounded-xl border border-slate-800 overflow-hidden">
                    <div class="p-4 bg-slate-900 border-b border-slate-800 font-mono text-xs text-cyan-400">
                        PREDICTIVE 3-LANE ALLOCATION RULES
                    </div>
                    <div class="divide-y divide-slate-800 text-sm">
                        <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-2 items-center">
                            <div><span class="font-bold text-red-400">Lane 1 (Slow/Right)</span> <p class="text-xs text-slate-400">Turning / Parking Ingress</p></div>
                            <div class="text-xs text-slate-300">Gradual deceleration; calibrated for turning/parking radii.</div>
                            <div class="text-xs font-mono text-amber-400">Avoid sudden braking; engine coasting</div>
                        </div>
                        <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-2 items-center bg-cyan-950/20">
                            <div><span class="font-bold text-cyan-400">Lane 2 (Cruising/Center)</span> <p class="text-xs text-slate-400">Long-range Steady Driving</p></div>
                            <div class="text-xs text-slate-300">Target Eco-Velocity ($V_{\text{opt}}$). Zero sudden lateral changes.</div>
                            <div class="text-xs font-mono text-emerald-400">Optimizes Air-Fuel Ratio (14.7:1)</div>
                        </div>
                        <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-2 items-center">
                            <div><span class="font-bold text-purple-400">Lane 3 (Express/Left)</span> <p class="text-xs text-slate-400">Overtaking / Non-parking</p></div>
                            <div class="text-xs text-slate-300">Temporary acceleration only for safe passing.</div>
                            <div class="text-xs font-mono text-purple-300">Prevent high-RPM bursts</div>
