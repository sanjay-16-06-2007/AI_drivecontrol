                        <div class="p-3 bg-slate-900/80 rounded-lg text-xs space-y-1">
                            <div class="flex justify-between">
                                <span class="text-slate-400">Available Slots:</span>
                                <span id="vacantCount" class="font-bold text-cyan-400">1 / 2</span>
